# Copy with npm run setup. Keep real keys in .env only.
# Choose fireworks OR groq, then fill that provider's key.
TRANSCRIPTION_PROVIDER=fireworks
APIFY_TOKEN=
TYPESAFE_API_KEY=
FIREWORKS_API_KEY=
GROQ_API_KEY=
PORT=5190

# Local pacing ceilings. Lower these to fit your actual account limits.
FIREWORKS_REQUESTS_PER_MINUTE=60
GROQ_REQUESTS_PER_MINUTE=20

# Recreation bridge (npm run recreate, or "Send to recreation" in the local app).
# RECREATION_DIR=D:\Video Editing\Freya Vids\_references
# To pull runs from your hosted lab instead of data/runs:
# CREATOR_LAB_URL=https://your-lab.up.railway.app
# CREATOR_LAB_PASSWORD=
